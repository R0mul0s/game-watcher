# Game Watcher — .env pro produkci (Websupport, game-watcher.rhsoft.cz)
# Zkopíruj na hosting jako `.env` (bez BOM!) a vyplň místa označená <…>.
#
# @author Roman Hlaváček
# @created 2026-10-11

APP_NAME="Game Watcher"
APP_ENV=production
APP_KEY=<docker compose exec app php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://game-watcher.rhsoft.cz

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning

# DB_HOST: údaje z detailu databáze ve WebAdminu
DB_CONNECTION=mariadb
DB_HOST=<host databáze>
DB_PORT=3306
DB_DATABASE=<název databáze>
DB_USERNAME=<uživatel>
DB_PASSWORD=<heslo>

# Session v šifrované cookie — bez tabulky sessions (R5)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Web jde jen přes HTTPS (public/.htaccess) — cookie neposílat po HTTP
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Zdroje cen (R9) — vlastní klíče pro produkci, ne vývojové
GAMES_ITAD_API_KEY=<klíč IsThereAnyDeal>
GAMES_GGDEALS_API_KEY=<klíč gg.deals>
