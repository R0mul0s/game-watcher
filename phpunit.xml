<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mariadb"/>
        <env name="DB_HOST" value="db"/>
        <env name="DB_DATABASE" value="games_test"/>
        <env name="DB_URL" value=""/>
        <!-- Testy nesmí volat skutečná API ani záviset na lokálních klíčích — jen Http::fake() -->
        <env name="GAMES_ITAD_API_KEY" value="test-itad-key"/>
        <env name="GAMES_GGDEALS_API_KEY" value="test-ggdeals-key"/>
        <env name="GAMES_IGDB_CLIENT_ID" value="test-igdb-client"/>
        <env name="GAMES_IGDB_CLIENT_SECRET" value="test-igdb-secret"/>
        <!-- Varování z testů (podvržené výpadky API) nemají plnit vývojový log -->
        <env name="LOG_CHANNEL" value="null"/>
        <env name="GAMES_CRON_TOKEN" value="test-cron-token"/>
        <!-- Testy nečekají mezi stránkami PS Store -->
        <env name="GAMES_PLAYSTATION_DELAY_MS" value="0"/>
        <env name="GAMES_PLAYSTATION_RETRY_DELAY_MS" value="0"/>
        <env name="GAMES_STEAM_DELAY_MS" value="0"/>
        <env name="GAMES_METACRITIC_DELAY_MS" value="0"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Prázdné klíče = upozornění na zařízení vypnutá; testy je zapnou přes enablePush() -->
        <env name="GAMES_PUSH_PUBLIC_KEY" value=""/>
        <env name="GAMES_PUSH_PRIVATE_KEY" value=""/>
        <env name="GAMES_PUSH_SUBJECT" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
