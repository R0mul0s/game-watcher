APP_NAME="Game Watcher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:54730

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker (compose.yaml) — z hostitele je databáze na localhost:54731
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=games
DB_USERNAME=games
DB_PASSWORD=games

# Session v šifrované cookie — bez tabulky sessions (R5 v docs/PLAN.md)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Produkce nemá worker fronty — vše synchronně
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log

# Zdroje cen (R9 v docs/PLAN.md) — klíče jsou zdarma, každý vývojář má vlastní:
# IsThereAnyDeal: isthereanydeal.com → Developer → My Apps → API key (OAuth není potřeba)
GAMES_ITAD_API_KEY=
# gg.deals: přihlášení → nastavení účtu → API
GAMES_GGDEALS_API_KEY=
